# Copy to .env and adjust. Nothing here is a secret; no API keys are needed.
APP_NAME="Smart Academic Document Analyzer"
DATABASE_URL=sqlite:///./data/analyzer.db
# MySQL later:  DATABASE_URL=mysql+pymysql://user:password@localhost:3306/analyzer
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=300
MIN_TEXT_CHARS=20
MAX_ANALYSIS_CHARS=500000
LOG_LEVEL=INFO
# JSON list
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
